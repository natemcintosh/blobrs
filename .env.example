# Azure Blob Storage Configuration
# Copy this file to .env for just run.
# Installed blobrs and cargo run do not load .env files: export the variable
# in your shell profile to run blobrs from any directory (see README.md).
# Sign in first with az login --identity or az login.

# Your Azure Storage Account name
AZURE_STORAGE_ACCOUNT=your_storage_account_name

# Container selection is done within the application.
# Storage access keys are not used; credentials come from the Azure CLI session.
